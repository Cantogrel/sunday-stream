{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunday Stream",
  "version": "0.2.1",
  "identifier": "com.binagames.sundaystream",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCM0FERDZDRjhBMjc4Q0MKUldUTWVLTDRiTjA2YTJBU0Rvejh2Z0tEZGl6YjlPTXoxTlh2Mjh1VGI5aDIxUHd3aEN1RDBwTVAK",
      "endpoints": [
        "https://github.com/Cantogrel/sunday-stream/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
